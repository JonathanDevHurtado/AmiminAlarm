<?xml version="1.0" encoding="utf-8"?>
<!--
  Reglas de extracción de datos para Android 12 (API 31) y superiores.
  Se respaldan los datos del usuario: base de datos (alarmas y eventos),
  preferencias (ajustes) y archivos internos (wallpaper).
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
